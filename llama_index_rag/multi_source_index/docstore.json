ysql_handbook.txt", "file_name": "mysql_handbook.txt", "file_type": "text/plain", "file_size": 433, "creation_date": "2026-08-20", "last_modified_date": "2026-08-20"}, "hash": "3a634154d2b28fd8c0beb94c48f7f082be2589d24aea623c08dba498aa9f3900", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "MySQL \u6545\u969c\u5904\u7406\u624b\u518c\r\n\r\n1. MySQL \u6162\u67e5\u8be2\r\n\u75c7\u72b6\uff1a\u63a5\u53e3\u54cd\u5e94\u6162\u3001CPU\u9ad8\r\n\u5904\u7406\u6b65\u9aa4\uff1a\r\n  1) \u5f00\u542f\u6162\u67e5\u8be2\u65e5\u5fd7\r\n  2) EXPLAIN \u5206\u6790\u6267\u884c\u8ba1\u5212\r\n  3) \u6dfb\u52a0\u5408\u9002\u7d22\u5f15\r\n\u9884\u9632\uff1a\u5b9a\u671f\u5206\u6790\u6162\u67e5\u8be2\u65e5\u5fd7\r\n\r\n2. MySQL \u8fde\u63a5\u6570\u8017\u5c3d\r\n\u75c7\u72b6\uff1aToo many connections\r\n\u5904\u7406\u6b65\u9aa4\uff1a\r\n  1) SHOW PROCESSLIST \u67e5\u770b\u8fde\u63a5\r\n  2) KILL \u957f\u65f6\u95f4\u672a\u91ca\u653e\u8fde\u63a5\r\n  3) \u4fee\u6539 max_connections\r\n\u9884\u9632\uff1a\u5408\u7406\u914d\u7f6e\u8fde\u63a5\u6c60", "mimetype": "text/plain", "start_char_idx": 0, "end_char_idx": 247, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "222b8471-2c82-4419-a0cc-e9b8c2c05d13": {"__data__": {"id_": "222b8471-2c82-4419-a0cc-e9b8c2c05d13", "embedding": null, "metadata": {"file_path": "E:\\project\\AI\\test_ai\\llama_index_rag\\data\\txt\\redis_handbook.txt", "file_name": "redis_handbook.txt", "file_type": "text/plain", "file_size": 533, "creation_date": "2026-08-20", "last_modified_date": "2026-08-20"}, "excluded_embed_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "excluded_llm_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "relationships": {"1": {"node_id": "b4197522-71f2-4941-8f94-5f2cd8808e2f", "node_type": "4", "metadata": {